{
  "$schema": "https://cdn.scalar.com/schema/scalar-config-next.json",
  "scalar": "2.0.0",
  "info": {
    "title": "Mojaloop Developers",
    "description": "Documentation for Mojaloop Developers"
  },
  "siteConfig": {
    "subdomain": "mojaloop-developers",
    "theme": "purple",
    "colorScheme": {
      "default": "system",
      "showToggle": true
    }
  },
  "navigation": {
    "routes": {
      "/": {
        "type": "group",
        "title": "Documentation",
        "hidden": false,
        "children": {
          "/": {
            "title": "Quickstart",
            "type": "page",
            "filepath": "docs-quickstart.md",
            "showInSidebar": true,
            "hidden": false
          },
          "/third-party-api": {
            "type": "group",
            "title": "Third-party API",
            "mode": "folder",
            "icon": "phosphor/regular/book",
            "children": {
              "admin-api": {
                "title": "Admin API",
                "type": "openapi",
                "mode": "folder",
                "singlePage": false,
                "showInSidebar": true,
                "hidden": false,
                "filepath": "./docs/thirdparty-admin-v2.0-openapi3-snippets.yaml"
              },
              "payments-initiation-api": {
                "title": "Payments Initiations API",
                "type": "openapi",
                "mode": "folder",
                "singlePage": false,
                "showInSidebar": true,
                "hidden": false,
                "filepath": "./docs/thirdparty-v2.0-openapi3-snippets.yaml"
              }
            }
          }
        }
      }
    }
  }
}