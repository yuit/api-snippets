{
    "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
    // audit-ci supports reading JSON, JSONC, and JSON5 config files.
    // Only use one of ["low": true, "moderate": true, "high": true, "critical": true]
    "moderate": true,
    "allowlist": [
        /**
            [05-18-2026] ws (WebSocket): Uninitialized memory disclosure.
            Not direct dependency of the repo but used inside "@redocly/cli@2.31.1", "browser-sync@3.0.4", and "socket.io@4.8.3".
        **/
        "GHSA-58qx-3vcg-4xpx",
        /**
            [06-25-2026] Transitive dev/build-tooling vulnerabilities (pulled in via @redocly/cli,
            browser-sync, socket.io) — not present in the published artifact. No non-breaking fix
            available (each fix requires a breaking major upgrade), so allowlisted pending that work:
              - GHSA-hmw2-7cc7-3qxx: form-data CRLF injection (high)
              - GHSA-h67p-54hq-rp68: js-yaml quadratic-complexity DoS (moderate; fix = json-refs@2 major)
              - GHSA-q8mj-m7cp-5q26: qs DoS via qs.stringify (moderate)
        **/
        "GHSA-hmw2-7cc7-3qxx",
        "GHSA-h67p-54hq-rp68",
        "GHSA-q8mj-m7cp-5q26"
    ]
}
